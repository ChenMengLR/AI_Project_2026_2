#!/bin/sh
set -eu

bad_paths=$(git diff --cached --name-only | grep -E '(^|/)\.env($|/)|(^|/)\.venv(/|$)|(^|/).*\.(pem|key)$' || true)
if [ -n "$bad_paths" ]; then
  echo "拒绝提交敏感文件："
  echo "$bad_paths"
  exit 1
fi

if git diff --cached -U0 | grep -E '(^|[[:space:]])(DASHSCOPE_API_KEY|OPENAI_API_KEY)[[:space:]]*=[[:space:]]*[^[:space:]]+' >/dev/null; then
  echo "拒绝提交疑似 API Key。"
  exit 1
fi

git diff --cached --check

if [ -x ".venv/Scripts/python.exe" ] && [ -d "tests" ]; then
  .venv/Scripts/python.exe -m unittest discover -s tests -p 'test_week03_chatbot.py' -q
fi
